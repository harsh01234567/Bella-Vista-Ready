# Bella Vista backend configuration.
# Copy this file to backend/.env and fill in real values. Never commit .env.

# "live"  - use the OpenAI Responses API + web_search tool to find real,
#           current product listings. Falls back to demo data automatically
#           if OPENAI_API_KEY is missing or a request fails.
# "demo"  - always use the local seeded 72-item catalog (no API key needed).
BELLA_VISTA_MODE=live

# Backend-only secret. NEVER expose this to the frontend/browser.
OPENAI_API_KEY=

# Any current OpenAI model that supports the Responses API + web_search tool.
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated list of frontend origins allowed to call this API in
# production, e.g. https://bellavista.app,https://www.bellavista.app
# Leave unset for local dev (defaults to the Vite dev server origins).
# Set to "*" only if you really mean "any origin" - not recommended.
BELLA_VISTA_ALLOWED_ORIGINS=

# Minutes an identical live search (same query + intent) is cached before
# OpenAI is called again for it.
BELLA_VISTA_SEARCH_CACHE_TTL_MINUTES=15

# Days to keep search_sessions/search_products and price_history rows before
# they're pruned on startup.
BELLA_VISTA_SESSION_RETENTION_DAYS=30
BELLA_VISTA_PRICE_HISTORY_RETENTION_DAYS=180

# If true, HEAD-check each product image_url and drop it to null unless it
# resolves with an image/* content-type. Off by default - adds a network
# round trip per product on every live search.
BELLA_VISTA_VALIDATE_IMAGE_URLS=false
